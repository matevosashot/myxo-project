# Environment variables for Cursor/VS Code (python.envFile).
# Allows the language server and debugger to launch the venv interpreter
# without needing  first.
LD_LIBRARY_PATH=/usr/local/python/Python-3.14.3/lib64:/usr/local/python/Python-3.14.3/lib
PYTHONPATH=/usr/local/python/Python-3.14.3/lib64/python3.14/lib-dynload
