Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"values", "[", "sol_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "maxval", ",", "grid", ",", "fs"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"grid", "=", 
       RowBox[{"sol", "[", "\"\<grid\>\"", "]"}]}], ";", 
      RowBox[{"fs", "=", 
       RowBox[{"sol", "[", "\"\<f\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vals", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"grid", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"grid", "[", 
              RowBox[{"[", "j", "]"}], "]"}], ",", 
             RowBox[{"fs", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j", ",", "i", ",", "j"}], "]"}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"sol", "[", "\"\<n\>\"", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"sol", "[", "\"\<n\>\"", "]"}]}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"maxval", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"vals", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vals", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "3"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"vals", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "3"}], "]"}], "]"}], "-", "maxval"}]}], ";", 
