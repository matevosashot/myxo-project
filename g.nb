Cell[BoxData[{
 RowBox[{
  RowBox[{"params", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"S0", "->", "1"}], ",", 
     RowBox[{"l", "->", "1"}], ",", 
     RowBox[{"lM", "->", 
      RowBox[{"7.0", "/", "3"}]}], ",", 
     RowBox[{"lm", "->", 
      RowBox[{"0.7", "/", "3"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"W", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "[", "r_", "]"}], ":=", 
  RowBox[{"S0", " ", 
   RowBox[{"f", "[", 
    RowBox[{"r", "/", "l"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"x", 
   SqrtBox[
    FractionBox[
     RowBox[{"0.34", "+", 
      RowBox[{"0.07", " ", 
       SuperscriptBox["x", "2"]}]}], 
     RowBox[{"1", "+", 
      RowBox[{"0.41", 
       SuperscriptBox["x", "2"]}], "+", 
      RowBox[{"0.07", 
       SuperscriptBox["x", "4"]}]}]]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]", "[", "\[Phi]_", "]"}], ":=", 
  RowBox[{"\[Phi]", "/", "2"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"S", "[", "r", "]"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", 
          RowBox[{"\[Theta]", "[", "\[Phi]", "]"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"S", "[", "r", "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", 
          RowBox[{"\[Theta]", "[", "\[Phi]", "]"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"S", "[", "r", "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", 
          RowBox[{"\[Theta]", "[", "\[Phi]", "]"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"S", "[", "r", "]"}]}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", 
          RowBox[{"\[Theta]", "[", "\[Phi]", "]"}]}], "]"}]}]}], "}"}]}], 
    "}"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "->", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}]]}], ",", 
     RowBox[{"\[Phi]", "->", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"x", ",", "y"}], "]"}]}]}], "}"}]}]}]}], "Input",
 CellChangeTimes->{{3.981648758434846*^9, 3.981648765293795*^9}, {
  3.981649041349815*^9, 3.981649042906143*^9}, {3.981740331083413*^9, 
  3.981740340193041*^9}, {3.981876080312296*^9, 3.98187609583862*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"c0744739-7658-48b6-9610-a10c70f9df34"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
     RowBox[{"Q", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"IdentityMatrix", "[", "2", "]"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["lM", "2"], "+", 
      SuperscriptBox["lm", "2"]}], ")"}]}], "+", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"Q", "[", 
     RowBox[{"x", ",", "y"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["lM", "2"], "-", 
      SuperscriptBox["lm", "2"]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "[", 
   RowBox[{"x1_", ",", "y1_", ",", "x2_", ",", "y2_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "2"], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"x1", ",", "y1"}], "]"}], 
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"MultinormalDistribution", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x1", ",", "y1"}], "}"}], ",", 
          RowBox[{"\[CapitalSigma]", "[", 
           RowBox[{"x1", ",", "y1"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x2", ",", "y2"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
     "+", 
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"x2", ",", "y2"}], "]"}], 
      RowBox[{"PDF", "[", 
       RowBox[{
        RowBox[{"MultinormalDistribution", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x2", ",", "y2"}], "}"}], ",", 
          RowBox[{"\[CapitalSigma]", "[", 
           RowBox[{"x2", ",", "y2"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x1", ",", "y1"}], "}"}]}], "]"}]}]}], ")"}]}]}]}], "Input",
