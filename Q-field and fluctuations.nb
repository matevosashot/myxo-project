Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"0.", " ", "Initialize", " ", "Parallel", " ", "Kernels"}], 
    "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Launching Kernels...\>\"", "]"}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"LaunchKernels", "[", "]"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Starts", " ", "worker", " ", "kernels", " ", "based", " ", "on", " ", 
     "your", " ", "CPU", " ", "core", " ", "count"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{"G", ",", "cfG"}], "]"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Sends", " ", "your", " ", "custom", " ", "function", " ", "G", " ", "to",
      " ", "all", " ", "workers"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"1.", " ", "Setup", " ", "Grid"}], "==="}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ngrid", "=", "64"}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{
    "You", " ", "can", " ", "now", " ", "likely", " ", "push", " ", "this", 
     " ", "to", " ", "32", " ", "or", " ", "64"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"L", "=", "40.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dx", "=", 
     RowBox[{"L", "/", "Ngrid"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"coords", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "L"}], "/", "2"}], ",", 
       RowBox[{
        RowBox[{"L", "/", "2"}], "-", "dx"}], ",", "dx"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Parallel", " ", "Grid", " ", 
     RowBox[{"Evaluation", ":", 
      RowBox[{
      "This", " ", "is", " ", "where", " ", "you", " ", "get", " ", "the", 
       " ", "biggest", " ", "speedup"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Evaluating G on 4D grid in parallel...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"GridG", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"cfG", "[", 
