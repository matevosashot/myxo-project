        RowBox[{"y1", ",", "coords"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y2", ",", "coords"}], "}"}], ",", 
       RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Forces", " ", "chunks", " ", "of", " ", "work"}], ",", 
        RowBox[{"reducing", " ", "overhead"}]}], "*)"}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
