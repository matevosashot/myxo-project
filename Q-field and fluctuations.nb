        RowBox[{
        "All", ",", "All", ",", "All", ",", "All", ",", "2", ",", "2"}], 
        "]"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freqs", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "<=", 
            RowBox[{"Ngrid", "/", "2"}]}], ",", 
           RowBox[{"i", "-", "1"}], ",", 
           RowBox[{"i", "-", "1", "-", "Ngrid"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "Ngrid"}], "}"}]}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"2", " ", 
         RowBox[{"Pi", "/", "L"}]}], ")"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"3.", " ", "Parallel", " ", "Algebraic", " ", "Equation"}], 
     "==="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Solving algebraic equation in parallel...\>\"", "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "We", " ", "only", " ", "parallelize", " ", "the", " ", "outermost", " ", 
     "loop", " ", 
     RowBox[{
      RowBox[{"(", "i1", ")"}], ".", "Parallelizing"}], " ", "all", " ", "4", 
     " ", "dimensions", " ", "creates", " ", "massive", " ", "overhead", " ", 
     "that", " ", "slows", " ", "Mathematica", " ", 
     RowBox[{"down", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FHat", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "k1", ",", "k2", ",", "p1", ",", "p2", ",", "normK2", ",", "normP2",
            ",", "numerator"}], "}"}], ",", 
         RowBox[{
          RowBox[{"k1", "=", 
           RowBox[{"freqs", "[", 
            RowBox[{"[", "i1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"k2", "=", 
              RowBox[{"freqs", "[", 
               RowBox[{"[", "i2", "]"}], "]"}]}], ";", 
             RowBox[{"p1", "=", 
              RowBox[{"freqs", "[", 
               RowBox[{"[", "j1", "]"}], "]"}]}], ";", 
             RowBox[{"p2", "=", 
              RowBox[{"freqs", "[", 
               RowBox[{"[", "j2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"normK2", "=", 
              RowBox[{
               RowBox[{"k1", "^", "2"}], "+", 
               RowBox[{"k2", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"normP2", "=", 
              RowBox[{
               RowBox[{"p1", "^", "2"}], "+", 
               RowBox[{"p2", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"normK2", ">", "0"}], "&&", 
                RowBox[{"normP2", ">", "0"}]}], ",", 
               RowBox[{
                RowBox[{"numerator", "=", 
                 RowBox[{
                  RowBox[{"k1", "*", "p1", "*", 
                   RowBox[{"G11Hat", "[", 
                    RowBox[{"[", 
                    RowBox[{"i1", ",", "i2", ",", "j1", ",", "j2"}], "]"}], 
                    "]"}]}], "+", 
                  RowBox[{"k1", "*", "p2", "*", 
                   RowBox[{"G12Hat", "[", 
                    RowBox[{"[", 
                    RowBox[{"i1", ",", "i2", ",", "j1", ",", "j2"}], "]"}], 
                    "]"}]}], "+", 
                  RowBox[{"k2", "*", "p1", "*", 
                   RowBox[{"G21Hat", "[", 
                    RowBox[{"[", 
                    RowBox[{"i1", ",", "i2", ",", "j1", ",", "j2"}], "]"}], 
                    "]"}]}], "+", 
                  RowBox[{"k2", "*", "p2", "*", 
                   RowBox[{"G22Hat", "[", 
                    RowBox[{"[", 
                    RowBox[{"i1", ",", "i2", ",", "j1", ",", "j2"}], "]"}], 
                    "]"}]}]}]}], ";", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"-", "numerator"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"normK2", "*", "normP2"}], ")"}]}]}], ",", 
               RowBox[{"0.", "+", 
                RowBox[{"0.", " ", "I"}]}]}], " ", 
              RowBox[{"(*", 
               RowBox[{"Zero", " ", "DC", " ", "component"}], "*)"}], "]"}]}],
             ",", 
            RowBox[{"{", 
             RowBox[{"i2", ",", "1", ",", "Ngrid"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j1", ",", "1", ",", "Ngrid"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j2", ",", "1", ",", "Ngrid"}], "}"}]}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i1", ",", "1", ",", "Ngrid"}], "}"}]}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{
     "4.", " ", "Inverse", " ", "FFT", " ", "to", " ", "Spatial", " ", 
      "Domain"}], "==="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Computing Inverse FFT...\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"fGrid", "=", 
     RowBox[{"Re", "[", 
      RowBox[{"InverseFourier", "[", "FHat", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Done!\>\"", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.981714921894644*^9, 3.981714952113652*^9}, 
   3.981715029578103*^9},
