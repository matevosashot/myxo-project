Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListContourPlot", "[", 
  RowBox[{"values", ",", 
   RowBox[{"Contours", "->", "20"}], ",", 
   RowBox[{"(*", 
    RowBox[{
    "Increase", " ", "this", " ", "number", " ", "for", " ", "more", " ", 
     "contour", " ", 
     RowBox[{"levels", "/", "bands"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
    "Maps", " ", "to", " ", "your", " ", "actual", " ", "spatial", " ", 
     "coordinates"}], "*)"}], 
   RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
   RowBox[{"(*", 
    RowBox[{"ContourStyle", " ", "controls", " ", "the", " ", "lines", " ", 
     RowBox[{"themselves", ":"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Use", " ", "Automatic", " ", "to", " ", "see", " ", "the", " ", 
      "lines"}], ",", 
     RowBox[{
     "or", " ", "None", " ", "to", " ", "just", " ", "see", " ", "the", " ", 
      "color", " ", "bands"}]}], "*)"}], 
   RowBox[{"ContourStyle", "->", "Automatic"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Contour Plot of f(x, x)\>\""}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x1 = y1\>\"", ",", "\"\<x2 = y2\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]], "Input",
