Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Visualize", " ", "diagonal", " ", "slice", " ", "f", 
    RowBox[{"(", 
     RowBox[{"x", ",", "y", ",", "x", ",", "y"}], ")"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fDiag", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"sol", "[", "\"\<f\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "i", ",", "j"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"sol", "[", "\"\<n\>\"", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"sol", "[", "\"\<n\>\"", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot3D", "[", 
    RowBox[{"fDiag", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<f(r, r)\>\""}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Visualize", " ", "f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y", ",", "0", ",", "0"}], ")"}]}], "*)"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"slice", "=", 
     RowBox[{"extractSlice", "[", 
      RowBox[{"sol", ",", "0.", ",", "0."}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ListPlot3D", "[", 
    RowBox[{
     RowBox[{"slice", "[", "\"\<slice\>\"", "]"}], ",", 
     RowBox[{"DataRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8"}], ",", "8"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<f(r, 0)\>\""}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Build", " ", "interpolating", " ", "function", " ", "for", " ", 
     "arbitrary", " ", "evaluation"}], "*)"}], " ", 
   RowBox[{
    RowBox[{"fInterp", "=", 
     RowBox[{"buildInterpolation", "[", "sol", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"fInterp", "[", 
    RowBox[{"1.0", ",", "0.5", ",", 
     RowBox[{"-", "0.3"}], ",", "0.2"}], "]"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"evaluate", " ", "at", " ", "any", " ", "point"}], 
    "*)"}]}]}]], "Input",
