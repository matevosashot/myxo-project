Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"RemoteEvaluate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"LaunchKernels", "[", 
      RowBox[{"2", "$ProcessorCount"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cfG", "=", 
      RowBox[{"Compile", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1", ",", "y1", ",", "x2", ",", "y2"}], "}"}], ",", 
        RowBox[{
         RowBox[{"G", "[", 
          RowBox[{"x1", ",", "y1", ",", "x2", ",", "y2"}], "]"}], "//", 
         "Evaluate"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ToExpression", "[", "packageCode", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"BiharmonicSolver`solveBiharmonicFourier", "[", 
       RowBox[{"cfG", ",", "128", ",", "8.0", ",", 
        RowBox[{"\"\<Method\>\"", "->", "\"\<Compiled\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"values", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"sol", "[", "\"\<grid\>\"", "]"}], "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"sol", "[", "\"\<grid\>\"", "]"}], "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"sol", "[", "\"\<f\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j", ",", "i", ",", "j"}], "]"}], "]"}]}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"sol", "[", "\"\<n\>\"", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"sol", "[", "\"\<n\>\"", "]"}]}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}], ";", "\[IndentingNewLine]", "values"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.981743923912345*^9, 3.98174394071591*^9}, {
